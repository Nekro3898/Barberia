# Conexión a MySQL: completar con los datos de tu instalación.
db_host=localhost
db_port=3306
db_user=root
db_password=
# Base original existente: el servidor no crea ni migra tablas.
db_name=barbershop
# Puerto HTTP de Express; también lo utiliza el proxy de Vite.
PORT=3001
# Zona del negocio para evaluar fechas y horas.
TZ=America/Argentina/Buenos_Aires
# Opcional: HOST=127.0.0.1 limita el acceso a esta computadora.
